generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PortalUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  employeeId   String?
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id String @id @default(cuid())
  employeeNumber String @unique
  firstName String
  lastName String
  status String
  hireDate DateTime
  departmentId String
  positionId String
  email String?
  emergencyContact String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id String @id @default(cuid())
  name String
  managerName String?
  notes String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id String @id @default(cuid())
  title String
  departmentId String
  level String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeRole {
  id String @id @default(cuid())
  name String
  description String
  permissions Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OnboardingChecklist {
  id                 String    @id @default(cuid())
  name               String
  description        String    @default("")
  positionId         String?
  targetRole         String?
  targetDepartmentId String?
  employeeId         String?
  templateId         String?
  status             String    @default("active")
  active             Boolean   @default(true)
  assignedAt         DateTime?
  completedAt        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  stepProgress       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model OnboardingStep {
  id               String   @id @default(cuid())
  checklistId      String
  title            String
  description      String   @default("")
  category         String   @default("General")
  ownerRole        String
  required         Boolean  @default(true)
  order            Int
  estimatedMinutes Int      @default(0)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TrainingModule {
  id String @id @default(cuid())
  title String
  description String @default("")
  category String
  level String @default("Beginner")
  targetRole String?
  estimatedMinutes Int @default(0)
  contentType String @default("SOP")
  contentReference String?
  status String @default("Draft")
  certificationEligible Boolean @default(false)
  sopDocumentId String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingAssignment {
  id                  String    @id @default(cuid())
  moduleId            String
  trainingModuleId    String?
  employeeId          String
  assignedAt          DateTime  @default(now())
  dueDate             DateTime?
  status              String
  completedAt         DateTime?
  score               Decimal?
  supervisorNotes     String?
  certificationIssued Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AttendanceRecord {
  id String @id @default(cuid())
  employeeId String
  clockedAt DateTime
  type String
  source String
  correctionStatus String
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimesheetRecord {
  id String @id @default(cuid())
  employeeId String
  periodStart DateTime
  periodEnd DateTime
  regularHours Decimal @default(0)
  overtimeHours Decimal @default(0)
  status String
  correctionNotes String?
  correctionReason String?
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleTemplate {
  id                 String    @id @default(cuid())
  name               String
  employeeId         String?
  departmentId       String?
  positionId         String?
  timezone           String?
  effectiveStartDate DateTime?
  effectiveEndDate   DateTime?
  status             String    @default("active")
  startTime          String
  endTime            String
  days               Json
  restDays           Json?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ScheduleInstance {
  id                 String   @id @default(cuid())
  employeeId         String
  templateId         String
  scheduleTemplateId String?
  workDate           DateTime
  startTime          String?
  endTime            String?
  breakMinutes       Int      @default(0)
  isRestDay          Boolean  @default(false)
  isHoliday          Boolean  @default(false)
  isTemporary        Boolean  @default(false)
  sourceType         String   @default("Regular")
  status             String
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PtoRequest {
  id             String   @id @default(cuid())
  employeeId     String
  leaveType      String?
  type           String?
  startDate      DateTime?
  endDate        DateTime?
  startsOn       DateTime
  endsOn         DateTime
  isHalfDay      Boolean  @default(false)
  halfDay        Boolean? @default(false)
  halfDayPortion String?
  isPaid         Boolean  @default(true)
  reason         String
  attachmentUrl  String?
  status         String
  requestedAt    DateTime @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNotes    String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PtoBalance {
  id         String   @id @default(cuid())
  employeeId String
  leaveType  String
  earned     Decimal  @default(0)
  used       Decimal  @default(0)
  remaining  Decimal  @default(0)
  year       Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ScheduleSwapRequest {
  id                          String    @id @default(cuid())
  requesterEmployeeId         String
  requestingEmployeeId        String?
  targetEmployeeId            String
  scheduleInstanceId          String
  requesterScheduleInstanceId String?
  targetScheduleInstanceId    String?
  requestedDate               DateTime?
  targetDate                  DateTime?
  reason                      String?
  requesterNotes              String?
  requesterNote               String?
  targetEmployeeNotes         String?
  targetNote                  String?
  managerNotes                String?
  managerNote                 String?
  targetEmployeeAcceptedAt    DateTime?
  managerApprovedBy           String?
  managerApprovedAt           DateTime?
  status                      String
  temporaryOnly               Boolean   @default(true)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model PayrollProfile {
  id String @id @default(cuid())
  employeeId String
  payType String
  baseFormulaCode String
  allowanceFormulaCodes Json
  deductionFormulaCodes Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollPeriod {
  id String @id @default(cuid())
  name String
  startsOn DateTime
  endsOn DateTime
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollFormula {
  id String @id @default(cuid())
  code String @unique
  name String
  expression String
  variables Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollComponent {
  id String @id @default(cuid())
  profileId String
  type String
  formulaCode String
  label String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BenefitRule {
  id String @id @default(cuid())
  name String
  eligibilityFormulaCode String
  amountFormulaCode String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GovernmentContributionSetting {
  id String @id @default(cuid())
  agencyName String
  employeeFormulaCode String
  employerFormulaCode String
  effectiveDate DateTime
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payslip {
  id String @id @default(cuid())
  employeeId String
  payrollPeriodId String
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayslipLineItem {
  id String @id @default(cuid())
  payslipId String
  label String
  componentType String
  formulaCode String
  previewAmount Decimal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ToolDeposit {
  id String @id @default(cuid())
  employeeId String
  equipmentItemId String?
  description String @default("")
  amountFormulaCode String
  initialAmount Decimal @default(0)
  balance Decimal @default(0)
  refundable Boolean @default(true)
  payrollFormulaCode String?
  notes String?
  status String
  resolvedAt DateTime?
  resolutionNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EquipmentItem {
  id String @id @default(cuid())
  assetTag String @unique
  name String
  serialNumber String?
  brand String?
  model String?
  category String
  condition String @default("good")
  location String?
  photoReference String?
  serialNumberPhotoReference String?
  damagePhotoReference String?
  status String
  assignedEmployeeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EquipmentAssignment {
  id String @id @default(cuid())
  employeeId String
  equipmentItemId String
  toolDepositId String?
  assignedOn DateTime
  returnedOn DateTime?
  conditionNotes String?
  damageStatus String @default("none")
  photoProofReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryItem {
  id String @id @default(cuid())
  sku String @unique
  name String
  unit String @default("pcs")
  quantityOnHand Decimal @default(0)
  reorderPoint Decimal @default(0)
  supplier String?
  costPlaceholder String?
  photoReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryMovement {
  id String @id @default(cuid())
  inventoryItemId String
  movementType String
  quantity Decimal
  reason String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DisciplineRecord {
  id String @id @default(cuid())
  employeeId String
  categoryId String
  severity String @default("written-warning")
  incidentDate DateTime
  summary String
  correctiveAction String?
  status String
  employeeAcknowledgedAt DateTime?
  hrReviewedAt DateTime?
  attachmentReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DisciplineCategory {
  id String @id @default(cuid())
  name String
  defaultSeverity String @default("written-warning")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CanteenTransaction {
  id String @id @default(cuid())
  employeeId String
  amount Decimal
  description String @default("")
  transactionDate DateTime
  deductionType String @default("salary-deduction")
  payrollFormulaCode String
  status String
  settledAmount Decimal @default(0)
  notes String?
  settledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeDebtLedger {
  id String @id @default(cuid())
  employeeId String
  source String
  balance Decimal @default(0)
  formulaCode String
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PerformanceReviewTemplate {
  id String @id @default(cuid())
  name String
  items Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PerformanceReview {
  id String @id @default(cuid())
  employeeId String
  templateId String
  reviewMonth String
  supervisorNotes String?
  status String
  employeeAcknowledgedAt DateTime?
  hrApprovedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PerformanceReviewItem {
  id String @id @default(cuid())
  reviewId String
  label String
  weight Decimal @default(0)
  score Decimal
  maxScore Decimal @default(10)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SopDocument {
  id String @id @default(cuid())
  title String
  description String @default("")
  category String
  documentType String @default("SOP")
  version String
  owner String
  fileReference String
  acknowledgementRequired Boolean @default(false)
  status String @default("Draft")
  effectiveDate DateTime?
  archivedAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SopAcknowledgement {
  id String @id @default(cuid())
  documentId String
  employeeId String
  status String
  acknowledgedAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLogEntry {
  id String @id @default(cuid())
  module String
  action String
  actor String
  entityId String
  summary String
  beforePayload Json?
  afterPayload Json?
  createdAt DateTime @default(now())
}

generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model Employee { id String @id @default(cuid()) employeeNumber String @unique firstName String lastName String status String hireDate DateTime departmentId String positionId String email String? emergencyContact String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Department { id String @id @default(cuid()) name String managerName String? notes String? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Position { id String @id @default(cuid()) title String departmentId String level String active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model EmployeeRole { id String @id @default(cuid()) name String description String permissions Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model OnboardingChecklist { id String @id @default(cuid()) name String positionId String? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model OnboardingStep { id String @id @default(cuid()) checklistId String title String ownerRole String required Boolean @default(true) order Int createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model TrainingModule { id String @id @default(cuid()) title String category String sopDocumentId String? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model TrainingAssignment { id String @id @default(cuid()) moduleId String employeeId String dueDate DateTime status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model AttendanceRecord { id String @id @default(cuid()) employeeId String clockedAt DateTime type String source String correctionStatus String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model TimesheetRecord { id String @id @default(cuid()) employeeId String periodStart DateTime periodEnd DateTime regularHours Decimal @default(0) overtimeHours Decimal @default(0) status String correctionNotes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ScheduleTemplate { id String @id @default(cuid()) name String departmentId String startTime String endTime String days Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ScheduleInstance { id String @id @default(cuid()) employeeId String templateId String workDate DateTime status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PtoRequest { id String @id @default(cuid()) employeeId String startsOn DateTime endsOn DateTime reason String status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ScheduleSwapRequest { id String @id @default(cuid()) requesterEmployeeId String targetEmployeeId String scheduleInstanceId String status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PayrollProfile { id String @id @default(cuid()) employeeId String payType String baseFormulaCode String allowanceFormulaCodes Json deductionFormulaCodes Json active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PayrollPeriod { id String @id @default(cuid()) name String startsOn DateTime endsOn DateTime status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PayrollFormula { id String @id @default(cuid()) code String @unique name String expression String variables Json active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PayrollComponent { id String @id @default(cuid()) profileId String type String formulaCode String label String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model BenefitRule { id String @id @default(cuid()) name String eligibilityFormulaCode String amountFormulaCode String active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model GovernmentContributionSetting { id String @id @default(cuid()) agencyName String employeeFormulaCode String employerFormulaCode String effectiveDate DateTime active Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Payslip { id String @id @default(cuid()) employeeId String payrollPeriodId String status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PayslipLineItem { id String @id @default(cuid()) payslipId String label String componentType String formulaCode String previewAmount Decimal? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ToolDeposit { id String @id @default(cuid()) employeeId String equipmentItemId String? amountFormulaCode String balance Decimal @default(0) status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model EquipmentItem { id String @id @default(cuid()) assetTag String @unique name String category String photoReference String? status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model EquipmentAssignment { id String @id @default(cuid()) employeeId String equipmentItemId String toolDepositId String? assignedOn DateTime returnedOn DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model InventoryItem { id String @id @default(cuid()) sku String @unique name String quantityOnHand Decimal @default(0) reorderPoint Decimal @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model InventoryMovement { id String @id @default(cuid()) inventoryItemId String movementType String quantity Decimal reason String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model DisciplineRecord { id String @id @default(cuid()) employeeId String categoryId String incidentDate DateTime summary String status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model DisciplineCategory { id String @id @default(cuid()) name String active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model CanteenTransaction { id String @id @default(cuid()) employeeId String amount Decimal transactionDate DateTime payrollFormulaCode String status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model EmployeeDebtLedger { id String @id @default(cuid()) employeeId String source String balance Decimal @default(0) formulaCode String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PerformanceReviewTemplate { id String @id @default(cuid()) name String items Json active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PerformanceReview { id String @id @default(cuid()) employeeId String templateId String reviewMonth String status String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PerformanceReviewItem { id String @id @default(cuid()) reviewId String label String score Decimal notes String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model SopDocument { id String @id @default(cuid()) title String category String version String owner String fileReference String active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model AuditLogEntry { id String @id @default(cuid()) module String action String actor String entityId String summary String beforePayload Json? afterPayload Json? createdAt DateTime @default(now()) }
